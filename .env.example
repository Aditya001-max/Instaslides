# ==============================================================================
# Slidegen & AV Control Suite - Environment Variables Template
# Copy this file to .env and configure with your specific environment settings.
# ==============================================================================

# --- OBS Studio WebSocket Configuration ---
OBS_WEBSOCKET_HOSTNAME=localhost
OBS_WEBSOCKET_PORT=4444
OBS_WEBSOCKET_PASSWORD=your_obs_websocket_password_here
OBS_SONG_SCENE_PREFIX="song "

# --- Slide & Directory Paths ---
RCLONE_REMOTE_DIR="remote:church/songs"
RCLONE_LOCAL_DIR="~/Documents/SongRepo"
OBS_SLIDES_DIR="~/Documents/OBS_Slides"
OBS_SUBDIR_NAMING="song_"
OBS_MIN_SUBDIRS=7

# --- Typography & Font Overrides ---
# Normal Font TTF path
FONT_PATH="/usr/share/fonts/TTF/century-gothic/CenturyGothic.ttf"
# Bold Font TTF path
BOLD_FONT_PATH="/usr/share/fonts/TTF/century-gothic/CenturyGothicBold.ttf"

# --- CD Recording & Live Marker Settings ---
CD_RECORD_CACHEFILE="~/.cache/slidegen/cd_record_cache.txt"
CD_RECORD_OUTPUT_BASEDIR="~/Recordings/Audio"
CD_RECORD_FFMPEG_INPUT_ARGS="-f dshow -i audio=\"Microphone (USB Audio Device)\""
CD_RECORD_PREFERED_DRIVE=""
CD_RECORD_PREFERED_SCSI_DRIVE=""
CD_RECORD_WEBSOCKET_HOST=localhost
CD_RECORD_WEBSOCKET_PORT=8765
CD_RECORD_WEBSOCKET_SLEEP=0.3

# --- Sermon Upload & FTP / WordPress Settings ---
SERMON_UPLOAD_USE_FTP=false
SERMON_UPLOAD_WPSM_API_BASE_URL="https://example-church.org/wp-json/wpsm/v1"
SERMON_UPLOAD_WPSM_USER="api_admin"
SERMON_UPLOAD_WPSM_PASSWORD="dummy_wpsm_app_password"

SERMON_UPLOAD_FTP_HOSTNAME="ftp.example-church.org"
SERMON_UPLOAD_FTP_USER="ftp_sermon_user"
SERMON_UPLOAD_FTP_PASSWORD="dummy_ftp_password"
SERMON_UPLOAD_FTP_UPLOAD_DIR="/public_html/sermons"

# --- Web Slide Generator Server ---
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=5000
